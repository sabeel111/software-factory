+    for (const existing of this.links.values()) if (existing.url === url) return existing;
     const link: Link = { slug: this.newSlug(), url, createdAt: now, clicks: 0, lastClickedAt: null };
     this.links.set(link.slug, link);
     return link;
   }
 
+  createWithSlug(url: string, slug: string, now: number): Link | null {
+    if (this.links.has(slug)) return null;
+    const link: Link = { slug, url, createdAt: now, clicks: 0, lastClickedAt: null };
+    this.links.set(slug, link);
+    return link;
+  }
+
