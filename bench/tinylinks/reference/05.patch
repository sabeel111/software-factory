diff --git a/src/router.ts b/src/router.ts
index 3ce2335..d927a6d 100644
--- a/src/router.ts
+++ b/src/router.ts
@@ -3,6 +3,8 @@ import { readJson, send } from "./http.ts";
 import type { Link, Store } from "./store.ts";
 import { normalizeUrl } from "./url.ts";
 
+const RESERVED_SLUGS = new Set(["api", "links"]);
+
 export interface Context {
   store: Store;
   now: () => number;
@@ -27,7 +29,18 @@ export async function route(ctx: Context, req: IncomingMessage, res: ServerRespo
     if (!body || typeof body.url !== "string") return send(res, 400, { error: "url is required" });
     const target = normalizeUrl(body.url);
     if (!target) return send(res, 400, { error: "invalid url" });
-    const link = ctx.store.create(target, ctx.now());
+    let link: Link;
+    if (body.slug !== undefined) {
+      const slug = body.slug;
+      if (typeof slug !== "string" || !/^[A-Za-z0-9_-]{3,32}$/.test(slug) || RESERVED_SLUGS.has(slug)) {
+        return send(res, 400, { error: "invalid slug" });
+      }
+      const custom = ctx.store.createWithSlug(target, slug, ctx.now());
+      if (!custom) return send(res, 409, { error: "slug already in use" });
+      link = custom;
+    } else {
+      link = ctx.store.create(target, ctx.now());
+    }
     return send(res, 201, toJson(link));
   }
 
diff --git a/src/store.ts b/src/store.ts
index 98af043..f26d99c 100644
--- a/src/store.ts
+++ b/src/store.ts
@@ -17,6 +17,13 @@ export class Store {
     return link;
   }
 
+  createWithSlug(url: string, slug: string, now: number): Link | null {
+    if (this.links.has(slug)) return null;
+    const link: Link = { slug, url, createdAt: now, clicks: 0, lastClickedAt: null };
+    this.links.set(slug, link);
+    return link;
+  }
+
   get(slug: string): Link | undefined {
     return this.links.get(slug);
   }
